				<div class="elementor-widget-container">
					<h2 class="elementor-heading-title elementor-size-default">ומה שבאמת מרגש בכל זה?</h2>				</div>
				</div>
				<div class="elementor-element elementor-element-43bff54 elementor-widget__width-initial elementor-invisible elementor-widget elementor-widget-image" data-id="43bff54" data-element_type="widget" data-e-type="widget" data-settings="{&quot;_animation&quot;:&quot;fadeInUp&quot;,&quot;_animation_delay&quot;:100}" data-widget_type="image.default">
