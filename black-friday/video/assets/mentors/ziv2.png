<script id="jquery-js-after">
jQuery(document).ready(function ($) {
            function updateItemCount() {
                let visibleCount = $('#res .jet-listing-grid__item #res-title').filter(function () {
                    let el = $(this);
                    return el.is(':visible') && el.css('display') !== 'none' && el.css('visibility') !== 'hidden' && el.css('opacity') !== '0' && el.width() > 0 && el.height() > 0;
                }).length;

                $('#item-count-display').text(visibleCount);
            }

            // Update immediately on document ready
            updateItemCount();

            // Ensure count updates on fast-loading pages
            requestAnimationFrame(updateItemCount);

            // Delay slightly in case JetEngine elements take a moment to render
            setTimeout(updateItemCount, 300);

            // Run when filters change
            $(document).on('jet-filter-content-rendered', updateItemCount);

            // Run when 'Load More' button is clicked
            $(document).on('click', '.jet-load-more', function () {
                setTimeout(updateItemCount, 200); // Reduce delay
            });

            // Use MutationObserver to detect DOM changes and update count instantly
            let targetNode = document.getElementById('res');
            if (targetNode) {
                let observer = new MutationObserver(updateItemCount);
                observer.observe(targetNode, { childList: true, subtree: true });
            }
        });
    
//# sourceURL=jquery-js-after
</script>
