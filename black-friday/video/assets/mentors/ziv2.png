<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"\u05dc\u05d9\u05d9\u05d1 \u05e4\u05ea\u05d9\u05d7\u05ea \u05e9\u05d1\u05d5\u05e2 \u05e2\u05dd \u05d6\u05d9\u05d5 \u2013 \u05db\u05e9\u05d4\u05ea\u05d6\u05de\u05d5\u05df \u05e4\u05d5\u05d2\u05e9 \u05d0\u05ea \u05d4\u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05ea","acceptedAnswer":{"@type":"Answer","text":"\u05d1\u05db\u05dc \u05e9\u05d1\u05d5\u05e2, \u05e0\u05e4\u05ea\u05d7\u05ea \u05d4\u05d3\u05dc\u05ea \u05dc\u05e9\u05d5\u05e7 \u05d7\u05d3\u05e9 \u2013 \u05d5\u05d1\u05db\u05dc \u05e9\u05d1\u05d5\u05e2, \u05d6\u05d9\u05d5 \u05e2\u05d5\u05dc\u05d4 \u05dc\u05e9\u05d9\u05d3\u05d5\u05e8 \u05d7\u05d9 \u05e2\u05dd \u05d7\u05d1\u05e8\u05d9 \u05d4\u05e7\u05d4\u05d9\u05dc\u05d4 \u05db\u05d3\u05d9 \u05dc\u05e0\u05ea\u05d7 \u05d0\u05ea \u05ea\u05d0\u05e8\u05d9\u05db\u05d9 \u05d4\u05de\u05e4\u05e0\u05d4 \u05e9\u05de\u05ea\u05e7\u05d1\u05dc\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05d4\u05d3\u05d5&quot;\u05d7 \u05d4\u05de\u05d7\u05d6\u05d5\u05e8\u05d9 \u05d4\u05d7\u05d5\u05d3\u05e9\u05d9.\u05d6\u05d4 \u05dc\u05d0 \u05e2\u05d5\u05d3 &quot;\u05e1\u05e7\u05d9\u05e8\u05d4 \u05e9\u05d5\u05e7&quot; \u05d2\u05e0\u05e8\u05d9\u05ea \u2013 \u05d0\u05dc\u05d0 \u05d7\u05d9\u05d1\u05d5\u05e8 \u05e2\u05de\u05d5\u05e7 \u05d1\u05d9\u05df \u05d4\u05d6\u05de\u05df, \u05d4\u05de\u05d7\u05d6\u05d5\u05e8\u05d9\u05d5\u05ea, \u05d5\u05d4\u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05e9\u05d1\u05d0\u05de\u05ea \u05e9\u05d5\u05d5\u05d4 \u05dc\u05e9\u05d9\u05dd \u05d0\u05dc\u05d9\u05d4\u05df \u05dc\u05d1 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e9\u05d1\u05d5\u05e2.\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05dc\u05d9\u05d9\u05d1, \u05d6\u05d9\u05d5 \u05e1\u05d5\u05e7\u05e8:\u05d0\u05ea \u05d4\u05e0\u05db\u05e1\u05d9\u05dd \u05e9\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05d3\u05d5\u05d7 \u05d4\u05d7\u05d5\u05d3\u05e9\u05d9 \u05d1\u05d5\u05e0\u05d4 \u05ea\u05e8\u05d7\u05d9\u05e9\u05d9\u05dd \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc\u05d9\u05d9\u05dd \u05dc\u05e2\u05e1\u05e7\u05d0\u05d5\u05ea \u05e2\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4 \u05d0\u05d5 \u05d4\u05de\u05e9\u05db\u05d9\u05d5\u05ea\u05d4\u05de\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05e9\u05dc \u05db\u05dc \u05ea\u05e8\u05d7\u05d9\u05e9 \u2013 \u05d5\u05d0\u05d9\u05da \u05d6\u05d4 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05e4\u05d5\u05da \u05dc\u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05ea \u05de\u05e1\u05d7\u05e8 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e9\u05d1\u05d5\u05e2\ud83d\udccc \u05d6\u05d4 \u05d4\u05e8\u05d2\u05e2 \u05e9\u05d1\u05d5 \u05d4\u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05dc\u05d0 \u05e8\u05e7 \u05dc\u05d5\u05de\u05d3\u05d9\u05dd \u05de\u05d4 \u05dc\u05e2\u05e9\u05d5\u05ea \u2013 \u05d0\u05dc\u05d0 \u05d2\u05dd \u05dc\u05de\u05d4, \u05de\u05ea\u05d9 \u05d5\u05d0\u05d9\u05da.\ud83d\udccc \u05d6\u05d4 \u05d4\u05de\u05e7\u05d5\u05dd \u05dc\u05d7\u05d3\u05d3 \u05d0\u05ea \u05d4\u05d7\u05e9\u05d9\u05d1\u05d4, \u05dc\u05e4\u05ea\u05d7 \u05e8\u05d0\u05d9\u05d9\u05d4 \u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05ea \u05d5\u05dc\u05d7\u05d5\u05d5\u05ea \u05de\u05e1\u05d7\u05e8 \u05d7\u05d9 \u05de\u05ea\u05d5\u05da \u05e9\u05e7\u05d8, \u05d5\u05d3\u05d0\u05d5\u05ea \u05d5\u05d1\u05d9\u05d8\u05d7\u05d5\u05df."}},{"@type":"Question","name":"\u05dc\u05d9\u05d9\u05d1 \u05de\u05e1\u05d7\u05e8 \u05de\u05ea\u05e7\u05d3\u05dd \u05e2\u05dd \u05e8\u05d5\u05e2\u05d9 \u2013 \u05db\u05e9\u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d4 \u05e4\u05d5\u05d2\u05e9\u05ea \u05d0\u05ea \u05d4\u05d2\u05e8\u05e3 \u05d4\u05d7\u05d9","acceptedAnswer":{"@type":"Answer","text":"\u05dc\u05d9\u05d9\u05d1 \u05e9\u05d1\u05d5\u05e2\u05d9 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e2\u05dd \u05e8\u05d5\u05e2\u05d9 \u05d1\u05df \u05d7\u05de\u05d5 (\u05e1\u05d5\u05d7\u05e8 \u05d5\u05d5\u05ea\u05d9\u05e7 \u05d5\u05de\u05e0\u05db&quot;\u05dc \u05de\u05e9\u05d5\u05ea\u05e3 \u05d1\u05e1\u05d9\u05d9\u05e7\u05dc\u05e1 \u05d8\u05e8\u05d9\u05d9\u05d3\u05d9\u05e0\u05d2) \u05dc\u05d1\u05d5\u05d2\u05e8\u05d9 \u05d4\u05e7\u05d5\u05e8\u05e1 \u05e9\u05db\u05d1\u05e8 \u05e0\u05de\u05e6\u05d0\u05d9\u05dd \u05d1\u05e9\u05dc\u05d1 \u05d4\u05d9\u05d9\u05e9\u05d5\u05dd.\u05e8\u05d5\u05e2\u05d9 \u05e4\u05d5\u05ea\u05d7 \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d4\u05de\u05e9\u05ea\u05ea\u05e4\u05d9\u05dd \u05d0\u05ea \u05d4\u05d2\u05e8\u05e3 \u05d4\u05d7\u05d9, \u05d5\u05d1\u05d5\u05d3\u05e7 \u05de\u05d4 \u05d1\u05d0\u05de\u05ea \u05e7\u05d5\u05e8\u05d4 \u05d1\u05e9\u05d5\u05e7, \u05d3\u05e8\u05da \u05d4\u05e2\u05d9\u05e0\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05e9\u05d9\u05d8\u05d4.\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05dc\u05d9\u05d9\u05d1:\u05e2\u05d5\u05e0\u05d9\u05dd \u05e2\u05dc \u05e9\u05d0\u05dc\u05d5\u05ea \u05d5\u05d0\u05ea\u05d2\u05e8\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05de\u05e1\u05d7\u05e8 \u05d0\u05de\u05d9\u05ea\u05d9\u05de\u05e0\u05ea\u05d7\u05d9\u05dd \u05d9\u05d7\u05d3 \u05de\u05e0\u05d9\u05d5\u05ea \u05e9\u05d4\u05d5\u05e2\u05dc\u05d5 \u05e2&quot;\u05d9 \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u2013 \u05ea\u05d5\u05da \u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05d9\u05d5\u05ea, \u05e1\u05d9\u05db\u05d5\u05e0\u05d9\u05dd \u05d5\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05e2\u05e1\u05e7\u05d4\u05dc\u05d5\u05de\u05d3\u05d9\u05dd \u05dc\u05d7\u05d3\u05d3 \u05d0\u05ea \u05d4\u05d9\u05d9\u05e9\u05d5\u05dd \u05e9\u05dc \u05de\u05d4 \u05e9\u05e0\u05dc\u05de\u05d3 \u05d1\u05e7\u05d5\u05e8\u05e1 \u2013 \u05d4\u05dc\u05db\u05d4 \u05dc\u05de\u05e2\u05e9\u05d4\u05de\u05ea\u05e8\u05d2\u05dc\u05d9\u05dd \u05d4\u05e1\u05ea\u05db\u05dc\u05d5\u05ea \u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05ea \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea, \u05e2\u05dd \u05d3\u05d9\u05d5\u05e7 \u05d2\u05d1\u05d5\u05d4, \u05d5\u05d3\u05d9\u05d5\u05df \u05e4\u05ea\u05d5\u05d7\ud83d\udccc \u05d6\u05d4 \u05d4\u05de\u05e7\u05d5\u05dd \u05e9\u05d1\u05d5 \u05d4\u05db\u05dc\u05d9\u05dd \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d8\u05d9\u05d9\u05dd \u05d4\u05d5\u05e4\u05db\u05d9\u05dd \u05dc\u05db\u05dc\u05d9\u05dd \u05de\u05e2\u05e9\u05d9\u05d9\u05dd \u05e2\u05dd \u05d4\u05d3\u05d9\u05e0\u05de\u05d9\u05e7\u05d4 \u05e9\u05dc \u05d4\u05e9\u05d5\u05e7.\ud83d\udccc \u05d6\u05d4 \u05d4\u05de\u05e7\u05d5\u05dd \u05e9\u05d1\u05d5 \u05de\u05ea\u05e7\u05d3\u05de\u05d9\u05dd \u05d1\u05d0\u05de\u05ea \u2013 \u05d3\u05e8\u05da \u05d7\u05d9\u05d3\u05d5\u05d3 \u05d4\u05d7\u05e9\u05d9\u05d1\u05d4, \u05e9\u05d9\u05d7 \u05e4\u05ea\u05d5\u05d7, \u05d5\u05e0\u05d2\u05d9\u05e2\u05d4 \u05de\u05e2\u05e9\u05d9\u05ea \u05e9\u05de\u05d7\u05d1\u05e8\u05ea \u05d1\u05d9\u05df \u05d9\u05d3\u05e2 \u05dc\u05ea\u05d5\u05e6\u05d0\u05d4."}},{"@type":"Question","name":"\u05dc\u05d7\u05e9\u05d5\u05d1 \u05db\u05de\u05d5 \u05e1\u05d5\u05d7\u05e8 \u05d0\u05de\u05d9\u05ea\u05d9 \u2013 \u05ea\u05e8\u05d7\u05d9\u05e9\u05d9 \u05de\u05e1\u05d7\u05e8 \u05d7\u05db\u05de\u05d9\u05dd \u05e2\u05dd \u05de\u05e0\u05d9 \u05d1\u05e8\u05d9\u05d6\u05dc","acceptedAnswer":{"@type":"Answer","text":"\u05de\u05e0\u05d9 \u05d1\u05e8\u05d9\u05d6\u05dc, \u05e1\u05d5\u05d7\u05e8 \u05e2\u05dd \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05e9\u05dc \u05de\u05e2\u05dc 35 \u05e9\u05e0\u05d4 \u05d1\u05e9\u05d5\u05d5\u05e7\u05d9\u05dd \u05d4\u05e4\u05d9\u05e0\u05e0\u05e1\u05d9\u05d9\u05dd, \u05d4\u05db\u05d9\u05e8 \u05d0\u05ea \u05e9\u05d9\u05d8\u05ea \u05e1\u05d9\u05d9\u05e7\u05dc\u05e1 \u05d8\u05e8\u05d9\u05d9\u05d3\u05d9\u05e0\u05d2 \u05d3\u05e8\u05da \u05d4\u05d3\u05d5&quot;\u05d7 \u05d4\u05d7\u05d5\u05d3\u05e9\u05d9 \u05d1\u05e9\u05e0\u05ea 2022 \u2013 \u05d5\u05de\u05d0\u05d6, \u05d4\u05d3\u05e8\u05da \u05d4\u05d9\u05d9\u05ea\u05d4 \u05d1\u05e8\u05d5\u05e8\u05d4:\u05ea\u05d0\u05e8\u05d9\u05db\u05d9 \u05d4\u05de\u05e4\u05e0\u05d4 \u05d4\u05e4\u05db\u05d5 \u05dc\u05db\u05dc\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc\u05d5 \u05d1\u05de\u05e1\u05d7\u05e8, \u05d5\u05d4\u05d5\u05d0 \u05dc\u05d0 \u05e8\u05e7 \u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d4\u05dd \u2013 \u05d4\u05d5\u05d0 \u05d4\u05ea\u05de\u05e7\u05e6\u05e2 \u05d1\u05d4\u05dd \u05dc\u05e8\u05de\u05d4 \u05e9\u05dc \u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d3\u05d5-\u05e1\u05e4\u05e8\u05ea\u05d9\u05d5\u05ea \u05d7\u05d5\u05d3\u05e9 \u05d0\u05d7\u05e8 \u05d7\u05d5\u05d3\u05e9.\u05de\u05d0\u05d6 \u05e9\u05d4\u05e6\u05d8\u05e8\u05e3 \u05dc\u05e6\u05d5\u05d5\u05ea \u05d4\u05de\u05e0\u05d8\u05d5\u05e8\u05d9\u05dd \u05e9\u05dc \u05d4\u05e7\u05d4\u05d9\u05dc\u05d4 \u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8 2025, \u05de\u05e0\u05d9 \u05de\u05dc\u05d5\u05d5\u05d4 \u05d0\u05ea \u05d4\u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05d5\u05d4\u05de\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05ea\u05e9\u05d5\u05e7\u05d4 \u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05d1\u05ea\u05d5\u05da \u05e7\u05d4\u05d9\u05dc\u05ea \u05d4\u05d3\u05d9\u05e1\u05e7\u05d5\u05e8\u05d3 \u05d5\u05d1\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05e9\u05de\u05d2\u05d9\u05e2 \u05de\u05d4\u05e9\u05d8\u05d7.\u05d0\u05d7\u05ea \u05d4\u05d3\u05e8\u05db\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d5\u05ea \u05e9\u05d1\u05d4\u05df \u05d4\u05d5\u05d0 \u05e2\u05d5\u05e9\u05d4 \u05d0\u05ea \u05d6\u05d4 \u05d4\u05d9\u05d0 \u05d3\u05e8\u05da \u05dc\u05d9\u05d9\u05d1 \u05e9\u05d1\u05d5\u05e2\u05d9 \u05d1\u05d0\u05de\u05e6\u05e2 \u05d4\u05e9\u05d1\u05d5\u05e2 \u2013 \u05e9\u05d9\u05d3\u05d5\u05e8 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9 \u05e9\u05d1\u05d5 \u05d4\u05d5\u05d0 \u05e1\u05d5\u05e7\u05e8 \u05ea\u05e8\u05d7\u05d9\u05e9\u05d9\u05dd \u05dc\u05de\u05e1\u05d7\u05e8 \u05d4\u05e7\u05e8\u05d5\u05d1, \u05de\u05e0\u05ea\u05d7 \u05d0\u05ea \u05ea\u05d0\u05e8\u05d9\u05db\u05d9 \u05d4\u05de\u05e4\u05e0\u05d4 \u05d4\u05e7\u05e8\u05d5\u05d1\u05d9\u05dd, \u05d5\u05de\u05d7\u05d1\u05e8 \u05d1\u05d9\u05df \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d4 \u05d5\u05d4\u05d9\u05d9\u05e9\u05d5\u05dd \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea.\ud83d\udccc \u05d6\u05d5 \u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05ea \u05e0\u05d3\u05d9\u05e8\u05d4 \u05dc\u05dc\u05de\u05d5\u05d3 \u05d0\u05d9\u05da \u05e1\u05d5\u05d7\u05e8 \u05d5\u05ea\u05d9\u05e7 \u05de\u05e4\u05e8\u05e9 \u05ea\u05d6\u05de\u05d5\u05df, \u05e1\u05d9\u05db\u05d5\u05df \u05d5\u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05ea \u2013 \u05de\u05ea\u05d5\u05da \u05d4\u05d1\u05e0\u05d4 \u05e2\u05de\u05d5\u05e7\u05d4 \u05e9\u05dc \u05e9\u05d9\u05d8\u05ea \u05d4\u05e1\u05d9\u05d9\u05e7\u05dc\u05d9\u05dd. \ud83d\udccc \u05db\u05dc \u05dc\u05d9\u05d9\u05d1 \u05d4\u05d5\u05d0 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d1\u05e4\u05e0\u05d9 \u05e2\u05e6\u05de\u05d5, \u05e9\u05de\u05d3\u05d9\u05d9\u05e7 \u05d0\u05ea \u05d4\u05d4\u05e1\u05ea\u05db\u05dc\u05d5\u05ea \u05e9\u05dc\u05da \u05d5\u05e4\u05d5\u05ea\u05d7 \u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05d7\u05d3\u05e9\u05d5\u05ea \u05dc\u05d7\u05e9\u05d9\u05d1\u05d4 \u05d5\u05dc\u05de\u05e1\u05d7\u05e8."}},{"@type":"Question","name":"\u05dc\u05d9\u05d9\u05d1 \u05e2\u05d5\u05de\u05e7 \u05e2\u05dd \u05d2\u05d5\u05dc\u05df \u05e2\u05d9\u05df \u05e6\u05d1\u05d9 \u2013 \u05d3\u05d9\u05d5\u05e7 \u05d1\u05de\u05e1\u05d7\u05e8 \u05de\u05ea\u05d5\u05da \u05d4\u05d1\u05e0\u05d4 \u05e9\u05dc \u05d4\u05d2\u05e8\u05e3","acceptedAnswer":{"@type":"Answer","text":"\u05d2\u05d5\u05dc\u05df \u05e2\u05d9\u05df \u05e6\u05d1\u05d9 \u05d4\u05d5\u05d0 \u05e1\u05d5\u05d7\u05e8 \u05d5\u05ea\u05d9\u05e7 \u05e2\u05dd \u05dc\u05de\u05e2\u05dc\u05d4 \u05de\u05be15 \u05e9\u05e0\u05d5\u05ea \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d1\u05d1\u05e0\u05d9\u05d9\u05ea \u05d0\u05dc\u05d2\u05d5\u05e8\u05d9\u05ea\u05de\u05d9\u05dd \u05dc\u05de\u05e1\u05d7\u05e8 \u2013 \u05d0\u05d1\u05dc \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d0\u05ea \u05d4\u05e9\u05e7\u05d8 \u05d4\u05e4\u05e0\u05d9\u05de\u05d9 \u05d1\u05de\u05e1\u05d7\u05e8 \u05d4\u05d5\u05d0 \u05de\u05e6\u05d0 \u05d3\u05e8\u05da \u05e9\u05d9\u05d8\u05ea \u05d4\u05e1\u05d9\u05d9\u05e7\u05dc\u05d9\u05dd.\u05d1\u05dc\u05d9\u05d9\u05d1 \u05d4\u05e9\u05d1\u05d5\u05e2\u05d9 \u05e9\u05d4\u05d5\u05d0 \u05de\u05e2\u05d1\u05d9\u05e8, \u05d2\u05d5\u05dc\u05df \u05de\u05d7\u05d1\u05e8 \u05d1\u05d9\u05df \u05e9\u05e0\u05d9 \u05e2\u05d5\u05dc\u05de\u05d5\u05ea:\u05de\u05e2\u05e0\u05d4 \u05dc\u05e9\u05d0\u05dc\u05d5\u05ea \u05d5\u05d0\u05ea\u05d2\u05e8\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05de\u05e1\u05d7\u05e8 \u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9 \u05de\u05e6\u05d3 \u05d0\u05d7\u05d3, \u05dc\u05d1\u05d9\u05df \u05e0\u05d9\u05ea\u05d5\u05d7 \u05ea\u05e8\u05d7\u05d9\u05e9\u05d9\u05dd \u05de\u05d1\u05d5\u05e1\u05e1\u05d9 \u05ea\u05d6\u05de\u05d5\u05df \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05ea\u05d0\u05e8\u05d9\u05db\u05d9 \u05d4\u05de\u05e4\u05e0\u05d4 \u05de\u05e6\u05d3 \u05e9\u05e0\u05d9.\ud83d\udccc \u05dc\u05d9\u05d9\u05d1 \u05e9\u05de\u05e9\u05dc\u05d1 \u05d4\u05d1\u05e0\u05d4 \u05e2\u05de\u05d5\u05e7\u05d4, \u05d7\u05e9\u05d9\u05d1\u05d4 \u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d5\u05d9\u05d9\u05e9\u05d5\u05dd \u05d1\u05d2\u05d5\u05d1\u05d4 \u05d4\u05e2\u05d9\u05e0\u05d9\u05d9\u05dd \u2013 \u05db\u05d3\u05d9 \u05e9\u05ea\u05d5\u05db\u05dc \u05dc\u05d0 \u05e8\u05e7 \u05dc\u05e1\u05d7\u05d5\u05e8 \u05e0\u05db\u05d5\u05df, \u05d0\u05dc\u05d0 \u05dc\u05d7\u05e9\u05d5\u05d1 \u05e0\u05db\u05d5\u05df \u2013 \u05d1\u05d6\u05de\u05df \u05d4\u05e0\u05db\u05d5\u05df."}},{"@type":"Question","name":"\u05de\u05d4 \u05e9\u05dc\u05d0 \u05d9\u05d5\u05e9\u05d1 \u2013 \u05de\u05ea\u05d9\u05d9\u05e9\u05d1 \u05db\u05d0\u05df. \u05dc\u05d9\u05d9\u05d1 \u05e9\u05d0\u05dc\u05d5\u05ea \u05d5\u05d4\u05d1\u05e0\u05d4 \u05e2\u05dd \u05e9\u05d2\u05d9\u05d0","acceptedAnswer":{"@type":"Answer","text":"\u05d4\u05e9\u05dc\u05d1 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05dc\u05de\u05d9\u05d3\u05d4 \u05d4\u05d5\u05d0 \u05d2\u05dd \u05d4\u05db\u05d9 \u05de\u05e8\u05d2\u05e9 \u2013 \u05d0\u05d1\u05dc \u05dc\u05e4\u05e2\u05de\u05d9\u05dd \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05e8\u05d2\u05d9\u05e9 \u05d2\u05dd \u05de\u05d1\u05dc\u05d1\u05dc.\u05e9\u05d2\u05d9\u05d0 \u05d0\u05d5\u05e1\u05e7\u05e8, \u05de\u05e0\u05d8\u05d5\u05e8 \u05d5\u05ea\u05d9\u05e7 \u05d1\u05e7\u05d4\u05d9\u05dc\u05d4 \u05d5\u05e1\u05d5\u05d7\u05e8 \u05de\u05e0\u05d5\u05e1\u05d4, \u05de\u05e2\u05d1\u05d9\u05e8 \u05dc\u05d9\u05d9\u05d1 \u05e9\u05d1\u05d5\u05e2\u05d9 \u05e9\u05de\u05d5\u05e7\u05d3\u05e9 \u05db\u05d5\u05dc\u05d5 \u05dc\u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05e9\u05e2\u05d3\u05d9\u05d9\u05df \u05de\u05e2\u05d1\u05d3\u05d9\u05dd \u05d0\u05ea \u05d4\u05d7\u05d5\u05de\u05e8 \u2013 \u05d5\u05e8\u05d5\u05e6\u05d9\u05dd \u05dc\u05d5\u05d5\u05d3\u05d0 \u05e9\u05d4\u05db\u05dc \u05d9\u05d5\u05e9\u05d1 \u05dc\u05d4\u05dd \u05db\u05de\u05d5 \u05e9\u05e6\u05e8\u05d9\u05da.\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05dc\u05d9\u05d9\u05d1, \u05e9\u05d2\u05d9\u05d0 \u05e2\u05d5\u05d6\u05e8:\u05dc\u05d7\u05d3\u05d3 \u05e0\u05d5\u05e9\u05d0\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05d4\u05e7\u05d5\u05e8\u05e1\u05dc\u05d4\u05d1\u05d9\u05df \u05e9\u05dc\u05d1 \u05d0\u05d7\u05e8\u05d9 \u05e9\u05dc\u05d1 \u05d0\u05ea \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4 \u05e2\u05dd \u05ea\u05d5\u05db\u05e0\u05ea \u05d4\u05d2\u05e8\u05e4\u05d9\u05dd\u05dc\u05d4\u05db\u05d9\u05e8 \u05d0\u05ea \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05d4\u05d1\u05e8\u05d5\u05e7\u05e8 \u05d1\u05e4\u05d5\u05e2\u05dc\u05d5\u05dc\u05e4\u05e9\u05d8 \u05db\u05dc \u05de\u05d5\u05e9\u05d2 \u05d0\u05d5 \u05ea\u05d4\u05dc\u05d9\u05da \u05e9\u05d4\u05e8\u05d2\u05d9\u05e9 \u05de\u05d5\u05e8\u05db\u05d1 \u05d1\u05dc\u05de\u05d9\u05d3\u05d4\ud83d\udccc\u05d4\u05db\u05dc \u05e7\u05d5\u05e8\u05d4 \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea, \u05e2\u05dd \u05dc\u05d9\u05d5\u05d5\u05d9 \u05d0\u05d9\u05e9\u05d9, \u05e9\u05d9\u05d7 \u05e2\u05dd \u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df \u05e4\u05ea\u05d5\u05d7 \u05d5\u05e6\u05d5\u05d5\u05ea \u05e9\u05de\u05e7\u05e9\u05d9\u05d1 \u05d1\u05d0\u05de\u05ea \u2013 \u05db\u05d3\u05d9 \u05e9\u05ea\u05d5\u05db\u05dc \u05dc\u05d4\u05ea\u05e7\u05d3\u05dd \u05e2\u05dd \u05e8\u05d0\u05e9 \u05e9\u05e7\u05d8 \u05d5\u05dc\u05d3\u05e2\u05ea \u05e9\u05d0\u05ea\u05d4 \u05d1\u05d0\u05de\u05ea \u05de\u05d1\u05d9\u05df \u05d0\u05ea \u05de\u05d4 \u05e9\u05e0\u05dc\u05de\u05d3 \u05d1\u05e7\u05d5\u05e8\u05e1.\u00a0"}},{"@type":"Question","name":"\u05e9\u05d0\u05dc\u05d5\u05ea, \u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05d5\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05d1\u05de\u05e1\u05d7\u05e8 \u2013 \u05d4\u05dc\u05d9\u05d9\u05d1 \u05d4\u05e9\u05d1\u05d5\u05e2\u05d9 \u05e2\u05dd \u05d9\u05d5\u05e1\u05e3","acceptedAnswer":{"@type":"Answer","text":"\u05db\u05dc \u05ea\u05dc\u05de\u05d9\u05d3 \u05e2\u05d5\u05d1\u05e8 \u05e9\u05dc\u05d1 \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d1\u05d8\u05d7\u05d5\u05df \u2013 \u05d5\u05d6\u05d4 \u05d1\u05d3\u05d9\u05d5\u05e7 \u05d4\u05de\u05e7\u05d5\u05dd \u05e9\u05d1\u05d5 \u05e0\u05db\u05e0\u05e1 \u05d4\u05dc\u05d9\u05d9\u05d1 \u05d4\u05e9\u05d1\u05d5\u05e2\u05d9 \u05e2\u05dd \u05d9\u05d5\u05e1\u05e3 \u05d1\u05df \u05e4\u05d5\u05e8\u05ea \u05e9\u05d3\u05d5\u05de\u05d4 \u05d1\u05de\u05d4\u05d5\u05ea\u05d5 \u05dc\u05dc\u05d9\u05d9\u05d1 \u05e9\u05de\u05e2\u05d1\u05d9\u05e8 \u05e9\u05d2\u05d9\u05d0 \u05d0\u05d5\u05e1\u05e7\u05e8.\u05d9\u05d5\u05e1\u05e3, \u05de\u05e0\u05d8\u05d5\u05e8 \u05d1\u05e7\u05d4\u05d9\u05dc\u05d4 \u05e2\u05dd 6 \u05e9\u05e0\u05d5\u05ea \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d1\u05de\u05e1\u05d7\u05e8, \u05de\u05e2\u05d1\u05d9\u05e8 \u05e9\u05d9\u05d3\u05d5\u05e8 \u05d7\u05d9 \u05e9\u05e0\u05d5\u05e2\u05d3 \u05dc\u05e2\u05e0\u05d5\u05ea \u05e2\u05dc \u05db\u05dc \u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05d5\u05d4\u05d0\u05ea\u05d2\u05e8\u05d9\u05dd \u05e9\u05e2\u05d5\u05dc\u05d9\u05dd \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05dc\u05de\u05d9\u05d3\u05d4:\u05d4\u05d1\u05e0\u05d4 \u05de\u05e2\u05de\u05d9\u05e7\u05d4 \u05e9\u05dc \u05e0\u05d5\u05e9\u05d0\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05d4\u05e7\u05d5\u05e8\u05e1\u05d7\u05d9\u05d3\u05d5\u05d3 \u05de\u05d5\u05e9\u05d2\u05d9\u05dd \u05e9\u05e4\u05d7\u05d5\u05ea \u05d4\u05ea\u05d9\u05d9\u05e9\u05d1\u05d5\u05de\u05e2\u05d1\u05e8 \u05d1\u05e8\u05d5\u05e8 \u05e2\u05dc \u05ea\u05d5\u05db\u05e0\u05ea \u05d4\u05beTradingView \u05d5\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d4\u05ea\u05e4\u05e2\u05d5\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05d1\u05e8\u05d5\u05e7\u05e8 \u05d1\u05e4\u05d5\u05e2\u05dc\ud83d\udccc\u05d4\u05e9\u05d9\u05d3\u05d5\u05e8 \u05d7\u05d9, \u05d1\u05d2\u05d5\u05d1\u05d4 \u05d4\u05e2\u05d9\u05e0\u05d9\u05d9\u05dd, \u05d5\u05db\u05d5\u05dc\u05dc \u05e6\u2019\u05d0\u05d8 \u05d5\u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df \u05e4\u05ea\u05d5\u05d7 \u05dc\u05e9\u05d0\u05dc\u05d5\u05ea \u2013 \u05db\u05da \u05e9\u05db\u05dc \u05ea\u05dc\u05de\u05d9\u05d3 \u05de\u05e8\u05d2\u05d9\u05e9 \u05e9\u05d9\u05e9 \u05dc\u05d5 \u05de\u05e7\u05d5\u05dd, \u05ea\u05de\u05d9\u05db\u05d4 \u05d5\u05de\u05d9\u05e9\u05d4\u05d5 \u05e9\u05d3\u05d5\u05d0\u05d2 \u05dc\u05d5 \u05d1\u05d0\u05de\u05ea.\u05db\u05d9 \u05d1\u05e8\u05d5\u05e8 \u05dc\u05e0\u05d5 \u05e9\u05d4\u05d4\u05e6\u05dc\u05d7\u05d4 \u05e9\u05dc\u05da \u05d1\u05de\u05e1\u05d7\u05e8 \u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05de\u05d4\u05d1\u05e0\u05d4 \u05de\u05dc\u05d0\u05d4 \u05d5\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05dc\u05e4\u05e2\u05d5\u05dc."}},{"@type":"Question","name":"\u05dc\u05e9\u05d0\u05d5\u05dc, \u05dc\u05d4\u05d1\u05d9\u05df, \u05dc\u05d3\u05d9\u05d9\u05e7 \u2013 \u05d0\u05d6\u05d5\u05e8 \u05d4\u05ea\u05de\u05d9\u05db\u05d4 \u05d4\u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05ea \u05e9\u05dc \u05ea\u05dc\u05de\u05d9\u05d3\u05d9 \u05d4\u05e7\u05d5\u05e8\u05e1","acceptedAnswer":{"@type":"Answer","text":"\u05d4\u05d0\u05d6\u05d5\u05e8 \u05e9\u05d1\u05d5 \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05de\u05e8\u05d2\u05d9\u05e9\u05d9\u05dd \u05d1\u05d8\u05d5\u05d7 \u05dc\u05e9\u05d0\u05d5\u05dc, \u05dc\u05d1\u05d3\u05d5\u05e7 \u05d5\u05dc\u05d4\u05e2\u05de\u05d9\u05e7.\u05d1\u05de\u05d2\u05d5\u05d5\u05df \u05d7\u05d3\u05e8\u05d9\u05dd \u05d9\u05d9\u05e2\u05d5\u05d3\u05d9\u05d9\u05dd \u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05d2\u05e8\u05e4\u05d9\u05dd \u05dc\u05d3\u05d9\u05d5\u05df, \u05dc\u05e9\u05d0\u05d5\u05dc \u05e9\u05d0\u05dc\u05d5\u05ea \u05e2\u05dc \u05ea\u05db\u05e0\u05d9 \u05d4\u05e7\u05d5\u05e8\u05e1, \u05dc\u05d1\u05e7\u05e9 \u05d4\u05d1\u05d4\u05e8\u05d5\u05ea \u05e2\u05dc \u05e0\u05d9\u05ea\u05d5\u05d7\u05d9\u05dd, \u05d5\u05dc\u05d5\u05d5\u05d3\u05d0 \u05e9\u05d4\u05d4\u05d1\u05e0\u05d4 \u05e9\u05dc\u05da \u05de\u05ea\u05d9\u05d9\u05e9\u05d1\u05ea \u05d1\u05d3\u05d9\u05d5\u05e7 \u05db\u05de\u05d5 \u05e9\u05e6\u05e8\u05d9\u05da.\ud83d\udccc \u05d9\u05e9 \u05d2\u05dd \u05d7\u05d3\u05e8 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05e9\u05d0\u05dc\u05d5\u05ea \u05e2\u05dc \u05ea\u05d5\u05db\u05e0\u05ea TradingView, \u05db\u05d5\u05dc\u05dc \u05ea\u05e4\u05e2\u05d5\u05dc, \u05db\u05dc\u05d9\u05dd \u05d5\u05d8\u05db\u05e0\u05d9\u05e7\u05d5\u05ea \u05e2\u05d1\u05d5\u05d3\u05d4 \u05d7\u05db\u05de\u05d5\u05ea.\ud83d\udccc \u05e6\u05d5\u05d5\u05ea \u05d4\u05de\u05e0\u05d8\u05d5\u05e8\u05d9\u05dd \u05de\u05d2\u05d9\u05d1, \u05de\u05db\u05d5\u05d5\u05df, \u05d5\u05de\u05e1\u05d1\u05d9\u05e8 \u05d1\u05d2\u05d5\u05d1\u05d4 \u05d4\u05e2\u05d9\u05e0\u05d9\u05d9\u05dd \u2013 \u05db\u05d3\u05d9 \u05e9\u05db\u05dc \u05e6\u05e2\u05d3 \u05d1\u05d3\u05e8\u05da \u05e9\u05dc\u05da \u05d9\u05d4\u05d9\u05d4 \u05d1\u05e8\u05d5\u05e8 \u05d5\u05d1\u05d8\u05d5\u05d7."}},{"@type":"Question","name":"\u05e1\u05d5\u05d7\u05e8\u05d9\u05dd \u05d1\u05d6\u05de\u05df \u2013 \u05ea\u05d5\u05d1\u05e0\u05d5\u05ea \u05d7\u05d9\u05d5\u05ea \u05de\u05e0\u05db\u05e1\u05d9 \u05d4\u05d3\u05d5\"\u05d7 \u05d4\u05d7\u05d5\u05d3\u05e9\u05d9","acceptedAnswer":{"@type":"Answer","text":"\u05dc\u05db\u05dc \u05e0\u05db\u05e1 \u05e9\u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05d3\u05d5&quot;\u05d7 \u2013 \u05d1\u05d9\u05df \u05d0\u05dd \u05d6\u05d4 \u05d4- S&amp;P, \u05d1\u05d9\u05d8\u05e7\u05d5\u05d9\u05df, \u05d6\u05d4\u05d1, \u05e0\u05e4\u05d8 \u05d5\u05d4\u05d9\u05d5\u05e8\u05d5 \u05d3\u05d5\u05dc\u05e8 \u2013 \u05d9\u05e9 '\u05d7\u05d3\u05e8' \u05d9\u05d9\u05e2\u05d5\u05d3\u05d9 \u05d5\u05de\u05e7\u05d5\u05dd \u05e7\u05d1\u05d5\u05e2 \u05d1\u05e7\u05d4\u05d9\u05dc\u05d4.\u05d1\u05db\u05dc \u05d7\u05d3\u05e8 \u05db\u05d6\u05d4 \u05de\u05ea\u05e0\u05d4\u05dc \u05e9\u05d9\u05d7 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9, \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea, \u05e1\u05d1\u05d9\u05d1 \u05ea\u05e8\u05d7\u05d9\u05e9\u05d9\u05dd \u05e9\u05de\u05d1\u05d5\u05e1\u05e1\u05d9\u05dd \u05e2\u05dc \u05ea\u05d0\u05e8\u05d9\u05db\u05d9 \u05d4\u05de\u05e4\u05e0\u05d4:\u05d4\u05d0\u05dd \u05d4\u05de\u05d4\u05dc\u05da \u05e7\u05e8\u05d5\u05d1? \u05de\u05d4 \u05d4\u05e9\u05d5\u05e7 \u05de\u05d0\u05d5\u05ea\u05ea? \u05d5\u05d0\u05d9\u05da \u05e0\u05db\u05d5\u05df \u05dc\u05e4\u05e2\u05d5\u05dc \u05d1\u05d4\u05ea\u05d0\u05dd \u05dc\u05e9\u05d9\u05d8\u05d4?\ud83d\udccc \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05d5\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05de\u05e9\u05ea\u05e4\u05d9\u05dd \u05e0\u05d9\u05ea\u05d5\u05d7\u05d9\u05dd, \u05e9\u05d5\u05d0\u05dc\u05d9\u05dd \u05e9\u05d0\u05dc\u05d5\u05ea, \u05d5\u05de\u05e7\u05d1\u05dc\u05d9\u05dd \u05d4\u05db\u05d5\u05d5\u05e0\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05de\u05d4\u05de\u05e0\u05d8\u05d5\u05e8\u05d9\u05dd \u2013\u00a0 \u00a0 \u00a0 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e4\u05d5\u05da \u05d0\u05ea \u05d4\u05d3\u05d5&quot;\u05d7 \u05de\u05de\u05e1\u05de\u05da \u05d7\u05d5\u05d3\u05e9\u05d9 \u05dc\u05de\u05e6\u05e4\u05df \u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9 \u05d1\u05de\u05e1\u05d7\u05e8."}},{"@type":"Question","name":"\u05e8\u05e2\u05d9\u05d5\u05e0\u05d5\u05ea \u05de\u05e1\u05d7\u05e8 \u05d5\u05de\u05e0\u05d9\u05d5\u05ea \u05d7\u05de\u05d5\u05ea \u2013 \u05d4\u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05e9\u05de\u05d7\u05db\u05d5\u05ea \u05dc\u05da \u05d1\u05e7\u05d4\u05d9\u05dc\u05d4","acceptedAnswer":{"@type":"Answer","text":"\u05d4\u05d7\u05d3\u05e8\u05d9\u05dd \u05d4\u05d0\u05dc\u05d5 \u2013 \u05e8\u05e2\u05d9\u05d5\u05e0\u05d5\u05ea \u05de\u05e1\u05d7\u05e8 \u05d5\u05de\u05e0\u05d9\u05d5\u05ea \u05d7\u05de\u05d5\u05ea \u2013 \u05d4\u05dd \u05d3\u05d5\u05d1\u05d3\u05d1\u05df \u05d0\u05de\u05d9\u05ea\u05d9.\u05d4\u05dd \u05de\u05d2\u05dc\u05de\u05d9\u05dd \u05d0\u05ea \u05d4\u05e2\u05d5\u05e6\u05de\u05d4 \u05e9\u05dc \u05e7\u05d4\u05d9\u05dc\u05d4 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05ea \u05e9\u05e2\u05d5\u05d1\u05d3\u05ea \u05dc\u05e4\u05d9 \u05d0\u05d5\u05ea\u05d4 \u05e9\u05d9\u05d8\u05d4, \u05de\u05d3\u05d1\u05e8\u05ea \u05d0\u05ea \u05d0\u05d5\u05ea\u05d4 \u05e9\u05e4\u05d4, \u05d5\u05de\u05d2\u05d1\u05d9\u05e8\u05d4 \u05d0\u05d7\u05d3 \u05dc\u05e9\u05e0\u05d9 \u05d0\u05ea \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d6\u05d4\u05d5\u05ea \u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05d9\u05d5\u05ea.\u05d1&quot;\u05d7\u05d3\u05e8 \u05e8\u05e2\u05d9\u05d5\u05e0\u05d5\u05ea \u05d4\u05de\u05e1\u05d7\u05e8&quot;, \u05d1\u05d5\u05d2\u05e8\u05d9 \u05d4\u05e7\u05d5\u05e8\u05e1 \u05de\u05e2\u05dc\u05d9\u05dd \u05de\u05e0\u05d9\u05d5\u05ea \u05e9\u05de\u05ea\u05d7\u05d9\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05d0\u05d5\u05ea \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc \u2013 \u05db\u05d0\u05dc\u05d4 \u05e9\u05e9\u05d5\u05d5\u05d4 \u05dc\u05e2\u05e7\u05d5\u05d1 \u05d0\u05d7\u05e8\u05d9\u05d4\u05df \u05d5\u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05dc\u05e8\u05e9\u05d9\u05de\u05d5\u05ea \u05d4\u05de\u05e2\u05e7\u05d1 \u05e9\u05dc\u05da.\u05d1\u05d7\u05d3\u05e8 &quot;\u05de\u05e0\u05d9\u05d5\u05ea \u05d7\u05de\u05d5\u05ea&quot;, \u05d0\u05ea\u05d4 \u05db\u05d1\u05e8 \u05de\u05e7\u05d1\u05dc \u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05e9\u05d4\u05d1\u05e9\u05d9\u05dc\u05d5 \u2013 \u05de\u05e0\u05d9\u05d5\u05ea \u05e9\u05e2\u05d5\u05de\u05d3\u05d5\u05ea \u05d1\u05ea\u05e0\u05d0\u05d9\u05dd \u05d4\u05d8\u05db\u05e0\u05d9\u05d9\u05dd \u05e9\u05dc\u05de\u05d3\u05ea \u05d1\u05e7\u05d5\u05e8\u05e1, \u05d5\u05e0\u05de\u05e6\u05d0\u05d5\u05ea \u05de\u05de\u05e9 \u05e2\u05dc \u05e1\u05e3 \u05db\u05e0\u05d9\u05e1\u05d4 \u05dc\u05e2\u05e1\u05e7\u05d4.\ud83d\udccc \u05e6\u05d5\u05d5\u05ea \u05d4\u05de\u05e0\u05d8\u05d5\u05e8\u05d9\u05dd \u05de\u05dc\u05d5\u05d5\u05d4, \u05de\u05d0\u05e9\u05e8, \u05d5\u05de\u05d7\u05d3\u05d3 \u2013 \u05d5\u05d0\u05ea\u05d4 \u05dc\u05d5\u05de\u05d3 \u05dc\u05d6\u05d4\u05d5\u05ea \u05d5\u05dc\u05e4\u05e2\u05d5\u05dc \u05de\u05ea\u05d5\u05da \u05d1\u05d9\u05d8\u05d7\u05d5\u05df.\ud83d\udccc \u05db\u05e9\u05d4\u05e7\u05d4\u05d9\u05dc\u05d4 \u05db\u05d5\u05dc\u05d4 \u05de\u05d7\u05e4\u05e9\u05ea \u05d1\u05d3\u05d9\u05d5\u05e7 \u05d0\u05ea \u05de\u05d4 \u05e9\u05d0\u05ea\u05d4 \u05de\u05d7\u05e4\u05e9 \u2013 \u05d4\u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05e4\u05e9\u05d5\u05d8 \u05de\u05ea\u05d2\u05dc\u05d5\u05ea."}},{"@type":"Question","name":"\u05e7\u05e8\u05d9\u05e4\u05d8\u05d5 \u05d5\u05de\u05d8\"\u05d7 \u2013 \u05d0\u05d5\u05ea\u05d4 \u05e9\u05d9\u05d8\u05d4, \u05e2\u05d5\u05dc\u05de\u05d5\u05ea \u05e9\u05dc\u05de\u05d9\u05dd \u05e9\u05dc \u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea","acceptedAnswer":{"@type":"Answer","text":"\u05d1\u05e7\u05d5\u05e8\u05e1 \u05d0\u05ea\u05d4 \u05dc\u05d5\u05de\u05d3 \u05dc\u05e1\u05d7\u05d5\u05e8 \u05d1\u05db\u05dc \u05e0\u05db\u05e1 \u05e9\u05e7\u05d9\u05d9\u05dd \u2013 \u05de\u05de\u05e0\u05d9\u05d5\u05ea, \u05d3\u05e8\u05da \u05de\u05d3\u05d3\u05d9\u05dd, \u05e1\u05d7\u05d5\u05e8\u05d5\u05ea, \u05de\u05d8&quot;\u05d7 \u05d5\u05e2\u05d3 \u05de\u05d8\u05d1\u05e2\u05d5\u05ea \u05e7\u05e8\u05d9\u05e4\u05d8\u05d5. \u05d6\u05d4 \u05dc\u05d0 \u05de\u05e9\u05e0\u05d4 \u05d1\u05de\u05d4 \u05ea\u05d1\u05d7\u05e8 \u05dc\u05d4\u05ea\u05de\u05e7\u05d3 \u2013 \u05db\u05d9 \u05db\u05e9\u05d0\u05ea\u05d4 \u05d9\u05d5\u05d3\u05e2 \u05dc\u05d4\u05e7\u05e9\u05d9\u05d1 \u05dc\u05d3\u05d5\u05e4\u05e7 \u05e9\u05dc \u05d4\u05d2\u05e8\u05e3, \u05d0\u05ea\u05d4 \u05d9\u05d5\u05d3\u05e2 \u05dc\u05d6\u05d4\u05d5\u05ea \u05ea\u05e0\u05d5\u05e2\u05d4, \u05dc\u05e4\u05e2\u05e0\u05d7 \u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05ea, \u05d5\u05dc\u05d4\u05d9\u05db\u05e0\u05e1 \u05e2\u05dd \u05d1\u05d9\u05d8\u05d7\u05d5\u05df.\u05d1\u05d3\u05d9\u05d5\u05e7 \u05d1\u05e9\u05d1\u05d9\u05dc \u05d6\u05d4 \u05e4\u05ea\u05d7\u05e0\u05d5 \u05d1\u05e7\u05d4\u05d9\u05dc\u05d4 \u05e9\u05e0\u05d9 \u05d7\u05d3\u05e8\u05d9\u05dd \u05d9\u05d9\u05e2\u05d5\u05d3\u05d9\u05d9\u05dd:\u05d0\u05d7\u05d3 \u05dc\u05de\u05e1\u05d7\u05e8 \u05d1\u05de\u05d8\u05d1\u05e2\u05d5\u05ea \u05e7\u05e8\u05d9\u05e4\u05d8\u05d5\u05d2\u05e8\u05e4\u05d9\u05d9\u05dd\u05d5\u05d0\u05d7\u05d3 \u05dc\u05de\u05e1\u05d7\u05e8 \u05d1\u05e6\u05de\u05d3\u05d9 \u05de\u05d8&quot;\u05d7\u05d1\u05d5\u05d2\u05e8\u05d9 \u05d4\u05e7\u05d5\u05e8\u05e1 \u05de\u05e2\u05dc\u05d9\u05dd \u05e9\u05dd \u05e8\u05e2\u05d9\u05d5\u05e0\u05d5\u05ea, \u05de\u05e9\u05ea\u05e4\u05d9\u05dd \u05e0\u05d9\u05ea\u05d5\u05d7\u05d9\u05dd \u05d7\u05d9\u05d9\u05dd \u05d5\u05d1\u05d5\u05e0\u05d9\u05dd \u05d9\u05d7\u05d3 \u05e8\u05e9\u05d9\u05de\u05d5\u05ea \u05de\u05e2\u05e7\u05d1 \u05e9\u05de\u05ea\u05d1\u05e1\u05e1\u05d5\u05ea \u05e2\u05dc \u05d0\u05d5\u05ea\u05dd \u05e2\u05e7\u05e8\u05d5\u05e0\u05d5\u05ea \u05e9\u05e0\u05dc\u05de\u05d3\u05d5 \u05d1\u05e7\u05d5\u05e8\u05e1 \u2013 \u05de\u05de\u05e9 \u05db\u05de\u05d5 \u05d1\u05d7\u05d3\u05e8\u05d9 \u05d4\u05de\u05e0\u05d9\u05d5\u05ea \u05d4\u05d7\u05de\u05d5\u05ea \u05d5\u05e8\u05e2\u05d9\u05d5\u05e0\u05d5\u05ea \u05d4\u05de\u05e1\u05d7\u05e8.\ud83d\udccc \u05db\u05da \u05e9\u05d2\u05dd \u05d0\u05dd \u05d4\u05ea\u05d7\u05d1\u05e8\u05ea \u05dc\u05e0\u05db\u05e1\u05d9\u05dd \u05d4\u05d0\u05dc\u05d4, \u05d0\u05ea\u05d4 \u05dc\u05d0 \u05dc\u05d1\u05d3 \u2013 \u05d0\u05ea\u05d4 \u05de\u05de\u05e9\u05d9\u05da \u05dc\u05e1\u05d7\u05d5\u05e8 \u05e2\u05dd \u05e7\u05d4\u05d9\u05dc\u05d4 \u05e9\u05d7\u05d5\u05e9\u05d1\u05ea \u05db\u05de\u05d5\u05da \u05d5\u05de\u05d3\u05d1\u05e8\u05ea \u05d0\u05ea \u05d0\u05d5\u05ea\u05d4 \u05e9\u05e4\u05d4."}},{"@type":"Question","name":"'\u05e0\u05d5\u05e1\u05d8\u05e8\u05d5' - \u05dc\u05e1\u05d7\u05d5\u05e8 \u05e2\u05dd \u05d4\u05d5\u05df \u05e9\u05dc \u05d0\u05d7\u05e8\u05d9\u05dd. \u05d1\u05dc\u05d9 \u05dc\u05e1\u05db\u05df \u05d0\u05ea \u05d4\u05db\u05e1\u05e3 \u05e9\u05dc\u05da.","acceptedAnswer":{"@type":"Answer","text":"\u05dc\u05de\u05d9 \u05e9\u05dc\u05d0 \u05de\u05db\u05d9\u05e8 \u2013 \u05e0\u05d5\u05e1\u05d8\u05e8\u05d5 \u05d4\u05d5\u05d0 \u05d7\u05e9\u05d1\u05d5\u05df \u05de\u05e1\u05d7\u05e8 \u05e9\u05de\u05de\u05d5\u05de\u05df \u05e2&quot;\u05d9 \u05d2\u05d5\u05e3 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9, \u05d5\u05d0\u05ea\u05d4 \u05db\u05e1\u05d5\u05d7\u05e8 \u05e4\u05d5\u05e2\u05dc \u05d1\u05d5 \u05e2\u05dd \u05d4\u05d5\u05df \u05dc\u05d0 \u05e9\u05dc\u05da.\u05d4\u05e8\u05d5\u05d5\u05d7 \u2013 \u05de\u05ea\u05d7\u05dc\u05e7. \u05d4\u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05ea \u2013 \u05e2\u05e6\u05d5\u05de\u05d4. \u05d0\u05d1\u05dc \u05d2\u05dd \u05d4\u05d0\u05d7\u05e8\u05d9\u05d5\u05ea.\u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05e7\u05d1\u05dc, \u05e6\u05e8\u05d9\u05da \u05dc\u05e2\u05d1\u05d5\u05e8 \u05de\u05d1\u05d7\u05e0\u05d9 \u05e7\u05d1\u05dc\u05d4, \u05d5\u05dc\u05e4\u05e2\u05d5\u05dc \u05d1\u05dc\u05d9\u05d9\u05d1 \u05ea\u05d7\u05ea \u05e0\u05d9\u05d4\u05d5\u05dc \u05e1\u05d9\u05db\u05d5\u05e0\u05d9\u05dd \u05e7\u05e4\u05d3\u05e0\u05d9 \u05de\u05d0\u05d5\u05d3.\u05d5\u05dc\u05db\u05df \u05e4\u05ea\u05d7\u05e0\u05d5 \u05d1\u05e7\u05d4\u05d9\u05dc\u05d4 \u05d7\u05d3\u05e8 \u05d9\u05d9\u05e2\u05d5\u05d3\u05d9 \u05dc\u05de\u05d9 \u05e9\u05d1\u05d5\u05d7\u05e8 \u05dc\u05e2\u05d1\u05d5\u05d3 \u05e2\u05dd \u05d7\u05e9\u05d1\u05d5\u05e0\u05d5\u05ea \u05e0\u05d5\u05e1\u05d8\u05e8\u05d5 \u2013 \u05de\u05e7\u05d5\u05dd \u05e9\u05d1\u05d5 \u05db\u05dc \u05de\u05d9 \u05e9\u05db\u05d1\u05e8 \u05d1\u05e4\u05e0\u05d9\u05dd, \u05d0\u05d5 \u05d1\u05d3\u05e8\u05da \u05dc\u05e9\u05dd, \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05ea\u05d9\u05d9\u05e2\u05e5, \u05dc\u05d3\u05d9\u05d9\u05e7, \u05dc\u05e9\u05ea\u05e3 \u05ea\u05e8\u05d7\u05d9\u05e9\u05d9\u05dd, \u05e9\u05d9\u05e7\u05d5\u05dc\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05d5\u05de\u05d4\u05dc\u05db\u05d9\u05dd \u05d8\u05e7\u05d8\u05d9\u05d9\u05dd \u05de\u05d4\u05e9\u05d5\u05e7 \u05d4\u05d0\u05de\u05d9\u05ea\u05d9.\ud83d\udccc \u05d6\u05d5 \u05dc\u05d0 \u05e2\u05d5\u05d3 \u05ea\u05d7\u05e0\u05d4 \u05d1\u05dc\u05de\u05d9\u05d3\u05d4 \u2013 \u05d6\u05d4 \u05d4\u05de\u05e7\u05d5\u05dd \u05e9\u05d1\u05d5 \u05de\u05e1\u05d7\u05e8 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05e4\u05d5\u05da \u05dc\u05de\u05e7\u05e6\u05d5\u05e2 \u05d5\u05db\u05e9\u05d0\u05ea\u05d4 \u05dc\u05d0 \u05dc\u05d1\u05d3, \u05d4\u05d3\u05e8\u05da \u05dc\u05e9\u05dd \u05ea\u05d4\u05d9\u05d4 \u05e7\u05e6\u05e8\u05d4 \u05d5\u05d9\u05e6\u05d9\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8"}},{"@type":"Question","name":"\u05e2\u05ea\u05d9\u05d3 \u05db\u05dc\u05db\u05dc\u05d9 \u05dc\u05d0 \u05d1\u05d5\u05e0\u05d9\u05dd \u05e2\u05dc \u05de\u05d6\u05dc \u2013 \u05d4\u05d7\u05d3\u05e8 \u05dc\u05d4\u05e9\u05e7\u05e2\u05d5\u05ea \u05d8\u05d5\u05d5\u05d7 \u05d0\u05e8\u05d5\u05da \u05d5\u05e4\u05e0\u05e1\u05d9\u05d4","acceptedAnswer":{"@type":"Answer","text":"\u05d4\u05de\u05e1\u05d7\u05e8 \u05d1\u05d8\u05d5\u05d5\u05d7 \u05d4\u05e7\u05e6\u05e8 \u05d9\u05db\u05d5\u05dc \u05dc\u05d9\u05d9\u05e6\u05e8 \u05ea\u05d6\u05e8\u05d9\u05dd, \u05d0\u05d1\u05dc \u05d4\u05d7\u05d5\u05e4\u05e9 \u05d4\u05d0\u05de\u05d9\u05ea\u05d9 \u05de\u05d2\u05d9\u05e2 \u05de\u05ea\u05db\u05e0\u05d5\u05df \u05d0\u05e8\u05d5\u05da \u05d8\u05d5\u05d5\u05d7.\u05d1\u05d7\u05d3\u05e8 \u05d4\u05d6\u05d4, \u05d4\u05e7\u05d4\u05d9\u05dc\u05d4 \u05de\u05e9\u05ea\u05e4\u05ea \u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d5\u05ea \u05dc\u05d8\u05d5\u05d5\u05d7 \u05d0\u05e8\u05d5\u05da \u2013\u05db\u05d5\u05dc\u05dc \u05de\u05d4\u05dc\u05db\u05d9\u05dd \u05d7\u05db\u05de\u05d9\u05dd \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05e9\u05e7\u05e2\u05d5\u05ea \u05e4\u05d0\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d4\u05ea\u05d0\u05de\u05ea \u05ea\u05d9\u05e7 \u05d4\u05d4\u05e9\u05e7\u05e2\u05d5\u05ea \u05dc\u05ea\u05e7\u05d5\u05e4\u05d5\u05ea \u05e9\u05d5\u05e0\u05d5\u05ea \u05d1\u05d7\u05d9\u05d9\u05dd,\u05d5\u05d2\u05dd \u05de\u05e2\u05e7\u05d1 \u05d5\u05d4\u05ea\u05d9\u05d9\u05e2\u05e6\u05d5\u05ea \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05db\u05e1\u05e4\u05d9\u05dd \u05d4\u05e4\u05e0\u05e1\u05d9\u05d5\u05e0\u05d9\u05d9\u05dd \u05d5\u05e0\u05d9\u05d5\u05d3 \u05d7\u05db\u05dd \u05d1\u05d9\u05df \u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd.\ud83d\udccc \u05db\u05d9 \u05de\u05d9 \u05e9\u05de\u05d1\u05d9\u05df \u05e9\u05d5\u05e7 \u2013 \u05d9\u05d5\u05d3\u05e2 \u05e9\u05d2\u05dd \u05d4\u05e4\u05e0\u05e1\u05d9\u05d4 \u05e9\u05dc\u05da \u05d6\u05d5 \u05e2\u05e1\u05e7\u05d4 \u05e9\u05e6\u05e8\u05d9\u05da \u05dc\u05e0\u05d4\u05dc \u05e0\u05db\u05d5\u05df.\ud83d\udccc \u05d5\u05e2\u05dd \u05e7\u05d4\u05d9\u05dc\u05d4 \u05e9\u05d7\u05d5\u05e9\u05d1\u05ea \u05e7\u05d3\u05d9\u05de\u05d4, \u05d0\u05ea\u05d4 \u05dc\u05d0 \u05e8\u05e7 \u05e1\u05d5\u05d7\u05e8 \u05d7\u05db\u05dd \u2013 \u05d0\u05ea\u05d4 \u05d1\u05d5\u05e0\u05d4 \u05e9\u05e7\u05d8 \u05db\u05dc\u05db\u05dc\u05d9 \u05dc\u05d8\u05d5\u05d5\u05d7 \u05d0\u05e8\u05d5\u05da."}}]}</script>
</body>
</html>
