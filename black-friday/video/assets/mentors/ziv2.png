				<div class="elementor-widget-container">
															<img loading="lazy" decoding="async" width="176" height="176" src="https://cyclestrading.com/wp-content/uploads/2025/04/Frame-921-1.png" class="attachment-large size-large wp-image-4522" alt="" srcset="https://cyclestrading.com/wp-content/uploads/2025/04/Frame-921-1.png 176w, https://cyclestrading.com/wp-content/uploads/2025/04/Frame-921-1-150x150.png 150w" sizes="(max-width: 176px) 100vw, 176px" />															</div>
